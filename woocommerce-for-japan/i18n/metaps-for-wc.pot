#: src/js/jp4wc/admin/settings/components/SecuritySettings.js:1229
msgid "Disable XML-RPC"
msgstr ""

#: src/js/jp4wc/admin/settings/components/SecuritySettings.js:1233
msgid "Refuse every XML-RPC method except the allowed ones, so that no password can be tried and no pingback sent through XML-RPC. Jetpack keeps working: it checks its own signature. The WordPress mobile apps, offline editors and services that log in through XML-RPC stop unless their methods are allowed. The REST API, with the application passwords used for it, is not affected."
msgstr ""

#: src/js/jp4wc/admin/settings/components/SecuritySettings.js:1247
msgid "Allowed methods"
msgstr ""

#: src/js/jp4wc/admin/settings/components/SecuritySettings.js:1252
